{
  "name": "blui-angular",
  "version": "10.0.0",
  "description": "Angular components for Brightlayer UI applications",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "start:showcase": "nx serve showcase-demo --port 3200 --open",
    "start": "nx serve demo --port 3300 --open",
    "build": "pnpm run build:lib",
    "build:lib": "nx run-many --target=build  --projects='@brightlayer-ui/angular-components,@brightlayer-ui/angular-themes' -c production",
    "build:lib:themes": "nx build @brightlayer-ui/angular-themes",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "test": "nx run-many --target=test --all",
    "test:ci": "pnpm run test --watch false",
    "test:demo": "nx test demo",
    "test:demo:ci": "pnpm run test:demo --watch false",
    "test:artifacts": "bash scripts/buildTest.sh",
    "coverage": "nx test demo --browsers=ChromeHeadless --no-watch --code-coverage",
    "changelog": "echo 'Changelog generation - implement as needed'",
    "release": "tsx -C import scripts/release.ts",
    "publish:package": "cd dist/libs/@brightlayer-ui/angular-components && rm -f *.tgz && set npm_config_yes=true && npx -p @brightlayer-ui/publish blui-publish",
    "tag:package": "npx -p @brightlayer-ui/tag blui-tag -s -blui-angular-components",
    "precommit": "pnpm run lint && pnpm run test:ci && pnpm run build && pnpm run test:artifacts && pnpm run generate:licenses",
    "generate:licenses": "npm-license-crawler -onlyDirectDependencies -json LICENSES.json"
  },
  "watch": {
    "copy-to-showcase": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,html,scss",
      "quiet": false,
      "runOnChangeOnly": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etn-ccis/blui-angular-component-library.git"
  },
  "keywords": [
    "angular",
    "components",
    "brightlayer-ui"
  ],
  "author": "brightlayer-ui <brightlayer-ui@eaton.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/etn-ccis/blui-angular-component-library/issues"
  },
  "homepage": "https://brightlayer-ui-components.github.io/angular",
  "directories": {
    "doc": "src/docs/md"
  },
  "dependencies": {
    "color": "5.0.0",
    "style-observer": "0.1.1",
    "tslib": "2.4.1"
  },
  "peerDependencies": {
    "@fontsource/open-sans": "^5.2.5"
  },
  "devDependencies": {
    "@analogjs/platform": "^1.17.1",
    "@analogjs/vite-plugin-angular": "^1.7.0",
    "@analogjs/vitest-angular": "^1.7.0",
    "@angular-devkit/build-angular": "18.2.20",
    "@angular-devkit/core": "18.2.20",
    "@angular-devkit/schematics": "18.2.20",
    "@angular/animations": "18.2.13",
    "@angular/cdk": "18.2.14",
    "@angular/cli": "~18.2.0",
    "@angular/common": "18.2.13",
    "@angular/compiler": "18.2.13",
    "@angular/compiler-cli": "18.2.13",
    "@angular/core": "18.2.13",
    "@angular/forms": "18.2.13",
    "@angular/material": "18.2.14",
    "@angular/platform-browser": "18.2.13",
    "@angular/platform-browser-dynamic": "18.2.13",
    "@angular/router": "18.2.13",
    "@brightlayer-ui/colors": "~3.1.1",
    "@brightlayer-ui/eslint-config": "~4.0.0",
    "@brightlayer-ui/icons": "~2.1.0",
    "@brightlayer-ui/icons-svg": "~1.11.0",
    "@eslint/js": "~8.57.0",
    "@hakimio/ngx-google-analytics": "~15.0.0",
    "@ngbracket/ngx-layout": "~18.0.0",
    "@nx/angular": "19.8.14",
    "@nx/eslint": "19.8.14",
    "@nx/eslint-plugin": "19.8.14",
    "@nx/js": "19.8.14",
    "@nx/vite": "19.8.14",
    "@nx/web": "19.8.14",
    "@nx/workspace": "19.8.14",
    "@schematics/angular": "18.2.20",
    "@swc-node/register": "1.9.2",
    "@swc/core": "1.5.29",
    "@swc/helpers": "0.5.17",
    "@types/node": "~18.16.9",
    "@types/prismjs": "~1.26.5",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/utils": "^8.23.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "~3.2.0",
    "angular-eslint": "~18.4.3",
    "autoprefixer": "~10.4.0",
    "enquirer": "^2.4.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "~9.0.0",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-prettier": "~5.4.1",
    "eslint-plugin-simple-import-sort": "~12.1.1",
    "jsdom": "~22.1.0",
    "marked": "~12.0.2",
    "ng-packagr": "18.2.1",
    "ngx-color-picker": "~18.0.0",
    "ngx-markdown": "~18.1.0",
    "npm-watch": "~0.11.0",
    "nx": "19.8.14",
    "picocolors": "^1.1.1",
    "postcss": "~8.4.5",
    "postcss-import": "~14.1.0",
    "postcss-preset-env": "~7.5.0",
    "postcss-url": "~10.1.3",
    "prettier": "~3.5.3",
    "prismjs": "~1.30.0",
    "rxjs": "~7.8.1",
    "semver": "^7.7.2",
    "ts-node": "~10.9.1",
    "tslib": "~2.4.1",
    "tsx": "^4.20.5",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "~5.0.0",
    "vite-plugin-dts": "~3.8.1",
    "vite-plugin-static-copy": "~3.0.2",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "~3.2.1",
    "zone.js": "~0.14.10"
  }
}
