{
    "name": "@brightlayer-ui/angular-themes",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/@brightlayer-ui/angular-themes/src",
    "prefix": "lib",
    "tags": [],
    "projectType": "library",
    "targets": {
        "build": {
            "executor": "@nx/angular:package",
            "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
            "options": {
                "project": "libs/@brightlayer-ui/angular-themes/ng-package.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "libs/@brightlayer-ui/angular-themes/tsconfig.lib.prod.json"
                },
                "development": {
                    "tsConfig": "libs/@brightlayer-ui/angular-themes/tsconfig.lib.json"
                }
            },
            "defaultConfiguration": "production"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "libs/@brightlayer-ui/angular-themes/jest.config.ts"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        }
    }
}
