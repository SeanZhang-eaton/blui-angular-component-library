{
  "name": "@brightlayer-ui/angular-components",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/@brightlayer-ui/angular-components/src",
  "prefix": "lib",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/@brightlayer-ui/angular-components",
        "main": "libs/@brightlayer-ui/angular-components/src/public-api.ts",
        "configFile": "libs/@brightlayer-ui/angular-components/vite.config.mts"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/@brightlayer-ui/angular-components/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/@brightlayer-ui/angular-components/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/@brightlayer-ui/angular-components/**/*.{ts,tsx,js,jsx}",
          "libs/@brightlayer-ui/angular-components/package.json"
        ]
      }
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test"
    }
  }
}
