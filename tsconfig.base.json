{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "target": "ES2022",
    "module": "es2020",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "paths": {
      "@blui-apps/demo/*": ["apps/demo/src/*"],
      "@blui-lab/angular": ["src/lab"],
      "@brightlayer-ui/angular-components": ["libs/@brightlayer-ui/angular-components/src/public-api.ts"],
      "@brightlayer-ui/angular-components/*": ["libs/@brightlayer-ui/angular-components/src/lib/*"],
      "@brightlayer-ui/angular-themes/*": ["libs/@brightlayer-ui/angular-themes/src/lib/*"]
    },
    "lib": ["es2018", "dom"],
    "useDefineForClassFields": false,
    "rootDir": "."
  },
  "exclude": ["node_modules", "tmp"]
}
