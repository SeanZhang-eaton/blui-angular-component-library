{
    "name": "demo",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "generators": {
        "@schematics/angular:component": {
            "style": "scss"
        },
        "@schematics/angular:application": {
            "strict": true
        }
    },
    "cli": {
        "cache": {
            "enabled": false
        }
    },
    "sourceRoot": "apps/demo/src",
    "prefix": "app",
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "options": {
                "outputPath": "dist/apps/demo",
                "index": "apps/demo/src/index.html",
                "main": "apps/demo/src/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "apps/demo/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    "apps/demo/src/favicon.ico",
                    "apps/demo/src/assets",
                    {
                        "glob": "**/*",
                        "input": "apps/demo/src/docs/md",
                        "output": "src/assets/md"
                    },
                    {
                        "glob": "icons.svg",
                        "input": "node_modules/@brightlayer-ui/icons-svg",
                        "output": "apps/demo/src/assets/blui-icons"
                    }
                ],
                "styles": [
                    "apps/demo/src/assets/fonts-material/material-icons.css",
                    "node_modules/@brightlayer-ui/icons/BrightlayerUIIcons.css",
                    "node_modules/prismjs/themes/prism-tomorrow.css",
                    "node_modules/prismjs/plugins/line-highlight/prism-line-highlight.css",
                    "node_modules/prismjs/plugins/line-numbers/prism-line-numbers.css",
                    {
                        "input": "libs/@brightlayer-ui/angular-themes/src/lib/theme.scss",
                        "inject": true,
                        "bundleName": "test11-theme"
                    },
                    {
                        "input": "libs/@brightlayer-ui/angular-themes/src/lib/open-sans.scss",
                        "inject": true,
                        "bundleName": "test11-open-sans"
                    },
                    {
                        "input": "apps/demo/src/styles.scss",
                        "inject": true,
                        "bundleName": "test11-custom-styles"
                    }
                ],
                "scripts": [
                    "node_modules/marked/marked.min.js",
                    "node_modules/prismjs/prism.js",
                    "node_modules/prismjs/components/prism-typescript.js",
                    "node_modules/prismjs/plugins/line-highlight/prism-line-highlight.js",
                    "node_modules/prismjs/plugins/line-numbers/prism-line-numbers.js"
                ]
            },
            "configurations": {
                "production": {
                    "tsConfig": "apps/demo/tsconfig.app.json",
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "3mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "10kb",
                            "maximumError": "20kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/demo/src/environments/environment.ts",
                            "with": "apps/demo/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "tsConfig": "apps/demo/tsconfig.app.json",
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "2mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "10kb",
                            "maximumError": "20kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/demo/src/environments/environment.ts",
                            "with": "apps/demo/src/environments/environment.dev.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "local": {
                    "tsConfig": "apps/demo/tsconfig.app.json",
                    "buildOptimizer": false,
                    "optimization": false,
                    "vendorChunk": true,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                },
                "npm": {
                    "tsConfig": "apps/demo/tsconfig.npm.json",
                    "buildOptimizer": false,
                    "optimization": false,
                    "vendorChunk": true,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "configurations": {
                "local": {
                    "buildTarget": "demo:build:local"
                },
                "npm": {
                    "buildTarget": "demo:build:npm"
                }
            },
            "defaultConfiguration": "local"
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "buildTarget": "demo:build"
            }
        },
        "test": {
            "executor": "@angular-devkit/build-angular:karma",
            "options": {
                "polyfills": ["zone.js", "zone.js/testing"],
                "tsConfig": "apps/demo/tsconfig.spec.json",
                "karmaConfig": "apps/demo/karma.conf.js",
                "inlineStyleLanguage": "scss",
                "assets": ["apps/demo/src/favicon.ico", "apps/demo/src/assets"],
                "styles": [
                    "apps/demo/src/styles.scss",
                    "apps/demo/src/assets/fonts-material/material-icons.css",
                    "libs/@brightlayer-ui/angular-themes/src/lib/theme.scss",
                    "libs/@brightlayer-ui/angular-themes/src/lib/open-sans.scss"
                ],
                "scripts": []
            }
        }
    }
}
